/* ========================================================================
   MISSION BEARD — Build Your Bundle PDP
   Conversion-optimised product page for the bundle builder.
   ======================================================================== */

@font-face {
  font-family: 'Jameson SS Round';
  src: url('{{ "byb-JamesonSSRound.ttf" | asset_url }}') format('truetype');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: 'Montserrat';
  src: url('{{ "byb-Montserrat-SemiBold.ttf" | asset_url }}') format('truetype');
  font-weight: 600;
  font-style: normal;
  font-display: swap;
}
@import url('https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Permanent+Marker&family=Anton&family=Montserrat:wght@400;500;700;800&family=Inter:wght@300;400;500;600;700&display=swap');

.byb {
  --mb-orange:        #E98517;
  --mb-orange-bright: #EF5D28;
  --mb-orange-soft:   #E68F5A;
  --mb-amber:         #FCA43A;

  --font-display:     'Jameson SS Round', 'Caveat Brush', 'Patrick Hand', cursive;
  --font-display-alt: 'Anton', 'Impact', 'Oswald', 'Arial Narrow', sans-serif;
  --font-sans:        'Montserrat', 'Inter', system-ui, -apple-system, sans-serif;
  --font-body:        'Montserrat', 'Inter', system-ui, sans-serif;

  --pg-bg:           #0c0a09;
  --pg-bg-2:         #15110d;
  --pg-card:         #1a1612;
  --pg-card-2:       #221d17;
  --pg-line:         rgba(255, 235, 200, 0.07);
  --pg-line-2:       rgba(255, 235, 200, 0.14);
  --pg-text:         #f4ede0;
  --pg-text-soft:    #b6a78f;
  --pg-text-mute:    #6b5f52;
  --pg-orange:       #E98517;
  --pg-orange-hot:   #EF5D28;
  --pg-orange-soft:  #f0b06d;
  --pg-paper:        #f4ede0;

  --underdog-1:      #c45a2c;
  --underdog-2:      #e8a060;
  --truenorth-1:     #3a7d5c;
  --truenorth-2:     #7eb89a;
  --elprez-1:        #d4a024;
  --elprez-2:        #f0d070;
  --sandal-1:        #8b5e3c;
  --sandal-2:        #c9a47a;

  background: var(--pg-bg);
  color: var(--pg-text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  position: relative;
  overflow-x: hidden;
}

.byb *, .byb *::before, .byb *::after { box-sizing: border-box; }
.byb img { display: block; max-width: 100%; }
.byb button { font-family: inherit; cursor: pointer; border: 0; background: none; color: inherit; padding: 0; }
.byb a { color: inherit; text-decoration: none; }

/* ── AMBIENT BG TEXTURE ───────────────────────── */
.byb::before {
  content: '';
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse at 18% 40%, rgba(196, 90, 44, 0.07) 0%, transparent 55%),
    radial-gradient(ellipse at 82% 18%, rgba(212, 160, 36, 0.04) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 90%, rgba(58, 125, 92, 0.04) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}
.byb::after {
  content: '';
  position: fixed; inset: 0;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: overlay;
}
.byb-page { position: relative; z-index: 2; }

/* ── ANNOUNCEMENT BAR ─────────────────────────── */
.byb-announce {
  background: var(--pg-orange);
  color: #1a0e02;
  padding: 9px 24px;
  text-align: center;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32px;
}
.byb-announce span { white-space: nowrap; }
.byb-announce .dot { color: rgba(26, 14, 2, 0.5); }
@media (max-width: 800px) {
  .byb-announce { gap: 12px; font-size: 10.5px; padding: 8px 14px; }
  .byb-announce .hide-sm { display: none; }
}

/* ── HEADER ───────────────────────────────────── */
.byb-hdr {
  position: sticky; top: 0; z-index: 80;
  background: rgba(12, 10, 9, 0.85);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--pg-line);
}
.byb-hdr-inner {
  max-width: 1340px; margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 18px 32px;
  gap: 24px;
}
.byb-hdr-nav {
  display: flex; gap: 28px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 12px;
  color: var(--pg-text);
}
.byb-hdr-nav a:hover { color: var(--pg-orange); }
.byb-hdr-nav.right { justify-content: flex-end; }
.byb-hdr-mark {
  display: flex; align-items: center; gap: 12px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.25em;
  font-size: 14px;
  color: var(--pg-orange);
}
.byb-hdr-mark img { height: 36px; width: auto; }
.byb-hdr-cart-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--pg-orange);
  color: #1a0e02;
  padding: 9px 16px;
  font-family: var(--font-display-alt);
  letter-spacing: 0.16em;
  font-size: 12px;
}
@media (max-width: 900px) {
  .byb-hdr-inner { grid-template-columns: auto 1fr auto; padding: 14px 18px; }
  .byb-hdr-nav.left { display: none; }
  .byb-hdr-mark { font-size: 11px; letter-spacing: 0.2em; }
  .byb-hdr-mark img { height: 28px; }
}

/* ── HERO / BUNDLE BUILDER ────────────────────── */
.byb-hero {
  max-width: 1340px;
  margin: 0 auto;
  padding: 40px 32px 80px;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
  gap: 56px;
  align-items: start;
}
@media (max-width: 1080px) {
  .byb-hero {
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 24px 20px 40px;
  }
}

.byb-crumb {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.22em;
  font-size: 11px;
  color: var(--pg-text-mute);
  margin-bottom: 18px;
}
.byb-crumb a:hover { color: var(--pg-orange); }
.byb-crumb .sep { margin: 0 10px; opacity: 0.5; }

/* GALLERY */
.byb-gallery { position: sticky; top: 88px; }
.byb-gallery-main {
  position: relative;
  aspect-ratio: 4/5;
  background: linear-gradient(180deg, #1a1411 0%, #0a0807 100%);
  border: 1px solid var(--pg-line);
  overflow: hidden;
}
.byb-gallery-main img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.byb-gallery-main:hover img { transform: scale(1.02); }
.byb-gallery-main .ribbon {
  position: absolute;
  top: 24px; left: 0;
  background: var(--pg-orange-hot);
  color: #1a0e02;
  padding: 8px 18px 8px 24px;
  font-family: var(--font-display-alt);
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  z-index: 2;
  clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 50%, 100% 100%, 0 100%);
}
.byb-gallery-main .ribbon-2 {
  position: absolute;
  top: 24px; right: 24px;
  background: rgba(12, 10, 9, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid var(--pg-line-2);
  color: var(--pg-paper);
  padding: 10px 16px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.05em;
  display: flex; align-items: center; gap: 8px;
}
.byb-gallery-main .ribbon-2 .live {
  width: 8px; height: 8px; background: #4ade80; border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.8);
  animation: byb-pulse-dot 2s infinite;
}
@keyframes byb-pulse-dot {
  0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.6); }
  70% { box-shadow: 0 0 0 10px rgba(74, 222, 128, 0); }
  100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
}

.byb-gallery-thumbs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  margin-top: 8px;
}
.byb-gallery-thumb {
  aspect-ratio: 1;
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
  overflow: hidden;
  position: relative;
  cursor: pointer;
  transition: border-color 0.2s, transform 0.2s;
}
.byb-gallery-thumb img { width: 100%; height: 100%; object-fit: cover; }
.byb-gallery-thumb.active { border-color: var(--pg-orange); }
.byb-gallery-thumb:hover { border-color: var(--pg-orange-soft); }
.byb-gallery-thumb.video::after {
  content: ''; position: absolute; inset: 0;
  background: rgba(0, 0, 0, 0.35);
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0 14px, transparent 15px);
  background-position: center;
  background-repeat: no-repeat;
}
.byb-gallery-thumb.video::before {
  content: '';
  position: absolute; left: 50%; top: 50%;
  width: 0; height: 0;
  transform: translate(-30%, -50%);
  border-left: 9px solid #1a0e02;
  border-top: 6px solid transparent;
  border-bottom: 6px solid transparent;
  z-index: 2;
}

/* BUYBOX */
.byb-buy { padding-top: 4px; }

.byb-buy-eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.22em;
  font-size: 12px;
  color: var(--pg-orange);
  margin-bottom: 16px;
}
.byb-buy-eyebrow .arr { width: 22px; height: 1px; background: var(--pg-orange); }
.byb-buy h1 {
  font-family: var(--font-display);
  font-size: clamp(48px, 5.6vw, 88px);
  line-height: 0.92;
  text-transform: uppercase;
  margin: 0 0 12px;
  font-weight: 400;
  text-wrap: balance;
}
.byb-buy h1 em { font-style: normal; color: var(--pg-orange); }
.byb-buy .lede {
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 17px;
  line-height: 1.55;
  color: var(--pg-text-soft);
  max-width: 540px;
  margin: 0 0 18px;
}

.byb-buy-stars {
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 28px;
  font-size: 14px;
  color: var(--pg-text-soft);
}
.byb-buy-stars .stars { color: var(--pg-orange); letter-spacing: 2px; font-size: 16px; }
.byb-buy-stars b { color: var(--pg-text); font-weight: 600; }
.byb-buy-stars a { text-decoration: underline; text-underline-offset: 3px; opacity: 0.7; }
.byb-buy-stars a:hover { opacity: 1; color: var(--pg-orange); }

/* TIER LADDER */
.byb-tier-label {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 12px;
  color: var(--pg-text-mute);
  margin: 16px 0 12px;
  display: flex; align-items: center; gap: 12px;
}
.byb-tier-label .step,
.byb-pickers-title .step {
  display: inline-flex; align-items: center; justify-content: center;
  width: 22px; height: 22px;
  background: var(--pg-orange);
  color: #1a0e02;
  border-radius: 50%;
  font-size: 12px;
  font-weight: 700;
}
.byb-tier-label .line { flex: 1; height: 1px; background: var(--pg-line); }

.byb-tiers {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-bottom: 24px;
}
.byb-tier {
  position: relative;
  background: var(--pg-card);
  border: 1.5px solid var(--pg-line);
  padding: 18px 12px 16px;
  cursor: pointer;
  transition: all 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  overflow: hidden;
  text-align: center;
}
.byb-tier:hover { border-color: var(--pg-orange-soft); background: var(--pg-card-2); }
.byb-tier.active {
  border-color: var(--pg-orange);
  background: linear-gradient(180deg, rgba(233, 133, 23, 0.12) 0%, var(--pg-card-2) 100%);
  box-shadow: 0 0 0 4px rgba(233, 133, 23, 0.12);
}
.byb-tier .tier-flag {
  position: absolute; top: 0; left: 0; right: 0;
  background: var(--pg-orange-hot);
  color: #1a0e02;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 9.5px;
  padding: 4px 0;
  font-weight: 600;
}
.byb-tier.has-flag { padding-top: 32px; }
.byb-tier .tier-qty {
  font-family: var(--font-display);
  font-size: 56px;
  line-height: 1;
  color: var(--pg-text);
  margin-bottom: 2px;
}
.byb-tier.active .tier-qty { color: var(--pg-orange); }
.byb-tier .tier-qty-cap {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 10px;
  color: var(--pg-text-mute);
  margin-bottom: 12px;
}
.byb-tier .tier-save {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 14px;
  color: var(--pg-orange);
  font-weight: 600;
  margin-bottom: 4px;
}
.byb-tier.active .tier-save { color: var(--pg-orange-hot); }
.byb-tier .tier-detail {
  font-size: 11px;
  color: var(--pg-text-mute);
  line-height: 1.3;
}
@media (max-width: 540px) {
  .byb-tiers { grid-template-columns: repeat(2, 1fr); }
}

/* SCENT PICKERS */
.byb-pickers {
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
  padding: 22px 22px 18px;
  margin-bottom: 24px;
}
.byb-pickers-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16px;
}
.byb-pickers-title {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 12px;
  color: var(--pg-text);
  display: flex; align-items: center; gap: 10px;
}
.byb-pickers-counter {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 12px;
  color: var(--pg-text-soft);
}
.byb-pickers-counter b { color: var(--pg-orange); font-weight: 600; }
.byb-pickers-counter.full b { color: #4ade80; }

.byb-picker-row {
  display: grid;
  grid-template-columns: 64px 1fr auto;
  gap: 16px;
  align-items: center;
  padding: 14px 0;
  border-top: 1px solid var(--pg-line);
}
.byb-picker-row:first-of-type { border-top-color: var(--pg-line-2); }
.byb-picker-thumb {
  width: 64px; height: 80px;
  background: #0a0807;
  overflow: hidden;
  position: relative;
  border: 1px solid var(--pg-line);
}
.byb-picker-thumb img { width: 100%; height: 100%; object-fit: cover; }
.byb-picker-thumb .fam {
  position: absolute; bottom: 4px; left: 4px; right: 4px;
  height: 4px;
}
.byb-picker-info { min-width: 0; }
.byb-picker-name {
  font-family: var(--font-display-alt);
  font-size: 22px;
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--pg-text);
  margin-bottom: 4px;
}
.byb-picker-note {
  font-family: var(--font-body);
  font-style: italic;
  font-size: 13px;
  color: var(--pg-text-soft);
}

.byb-qty-pill {
  display: inline-flex; align-items: center;
  background: #0a0807;
  border: 1px solid var(--pg-line);
  height: 40px;
}
.byb-qty-pill button {
  width: 38px; height: 38px;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  color: var(--pg-text-soft);
  transition: color 0.15s;
}
.byb-qty-pill button:hover { color: var(--pg-orange); }
.byb-qty-pill button:disabled { color: var(--pg-text-mute); cursor: not-allowed; opacity: 0.5; }
.byb-qty-pill .qty-val {
  width: 32px; text-align: center;
  font-family: var(--font-display-alt);
  font-size: 18px;
  color: var(--pg-text);
}
.byb-qty-pill.has-val { border-color: var(--pg-orange-soft); background: rgba(233, 133, 23, 0.06); }

/* PRICE & ATC */
.byb-price-row {
  display: flex; align-items: baseline; gap: 14px;
  margin: 6px 0 18px;
  padding: 18px 20px;
  background: linear-gradient(90deg, rgba(233, 133, 23, 0.08) 0%, transparent 80%);
  border-left: 3px solid var(--pg-orange);
}
.byb-price-row .now {
  font-family: var(--font-display-alt);
  font-size: 38px;
  letter-spacing: 0.01em;
  color: var(--pg-text);
  line-height: 1;
}
.byb-price-row .was {
  font-family: var(--font-display-alt);
  font-size: 22px;
  color: var(--pg-text-mute);
  text-decoration: line-through;
  text-decoration-thickness: 1.5px;
}
.byb-price-row .save {
  margin-left: auto;
  font-family: var(--font-display);
  font-size: 32px;
  text-transform: uppercase;
  color: var(--pg-orange);
  transform: rotate(-4deg);
  line-height: 1;
}
.byb-price-row .per {
  font-size: 12px;
  font-family: var(--font-display-alt);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--pg-text-mute);
  align-self: end;
  margin-left: 4px;
}

.byb-atc {
  width: 100%;
  background: var(--pg-orange);
  color: #1a0e02;
  padding: 22px 24px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 16px;
  display: flex; align-items: center; justify-content: center; gap: 14px;
  border: 2px solid var(--pg-orange);
  transition: all 0.16s cubic-bezier(0.2, 0.8, 0.2, 1);
  font-weight: 600;
}
.byb-atc:hover { background: var(--pg-orange-hot); border-color: var(--pg-orange-hot); transform: translateY(-1px); }
.byb-atc:active { transform: translateY(0) scale(0.99); }
.byb-atc:disabled {
  background: var(--pg-card);
  border-color: var(--pg-line);
  color: var(--pg-text-mute);
  cursor: not-allowed;
  transform: none;
}
.byb-atc .arr-r { font-family: var(--font-body); font-size: 18px; letter-spacing: 0; }
.byb-atc-helper {
  text-align: center;
  font-size: 12px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--pg-text-mute);
  margin-top: 12px;
  line-height: 1.5;
}
.byb-atc-helper b { color: var(--pg-text); font-weight: 600; }

/* TRUST */
.byb-trust {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid var(--pg-line);
}
.byb-trust-item {
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px;
  font-family: var(--font-body);
  font-weight: 600;
  color: var(--pg-text-soft);
  line-height: 1.3;
}
.byb-trust-item .ic {
  width: 28px; height: 28px;
  background: rgba(233, 133, 23, 0.15);
  color: var(--pg-orange);
  display: flex; align-items: center; justify-content: center;
  font-size: 14px;
  flex-shrink: 0;
}
@media (max-width: 540px) {
  .byb-trust { grid-template-columns: 1fr; gap: 8px; }
}

/* ── SECTION GENERIC ──────────────────────────── */
.byb-section {
  max-width: 1340px;
  margin: 0 auto;
  padding: 96px 32px;
}
.byb-section-eyebrow {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.28em;
  font-size: 12px;
  color: var(--pg-orange);
  display: inline-flex; align-items: center; gap: 12px;
}
.byb-section-eyebrow::before {
  content: ''; width: 24px; height: 1px; background: var(--pg-orange);
}
.byb-section-h2 {
  font-family: var(--font-display);
  font-size: clamp(48px, 6vw, 96px);
  line-height: 0.92;
  text-transform: uppercase;
  margin: 14px 0 18px;
  font-weight: 400;
  text-wrap: balance;
}
.byb-section-h2 em { font-style: normal; color: var(--pg-orange); }
.byb-section-sub {
  font-family: var(--font-body);
  font-size: 17px;
  color: var(--pg-text-soft);
  line-height: 1.55;
  max-width: 560px;
}
.byb-section-head {
  margin-bottom: 56px;
  display: flex; flex-direction: column; align-items: flex-start;
}
.byb-section-head.center { align-items: center; text-align: center; }
.byb-section-head.center .byb-section-sub { margin: 0 auto; }
@media (max-width: 800px) {
  .byb-section { padding: 64px 20px; }
  .byb-section-head { margin-bottom: 36px; }
}

/* ── VIDEO CAROUSEL ───────────────────────────── */
.byb-vidsec {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(196, 90, 44, 0.12) 0%, transparent 50%),
    var(--pg-bg-2);
  border-top: 1px solid var(--pg-line);
  border-bottom: 1px solid var(--pg-line);
}
.byb-vidsec .head-row {
  display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end;
  margin-bottom: 24px;
}
.byb-vid-carousel { position: relative; margin-top: 40px; }
.byb-vid-track {
  display: flex;
  gap: 24px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  padding: 8px 32px 32px;
  margin: -8px -32px 0;
  scrollbar-width: none;
}
.byb-vid-track::-webkit-scrollbar { display: none; }
.byb-vid-card {
  flex: 0 0 360px;
  scroll-snap-align: center;
  position: relative;
  aspect-ratio: 9/14;
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
  overflow: hidden;
  cursor: pointer;
  transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.32s;
}
.byb-vid-card:hover { transform: translateY(-4px); border-color: var(--pg-orange-soft); }
.byb-vid-card .poster {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.byb-vid-card:hover .poster { transform: scale(1.04); }
.byb-vid-card .protect {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.0) 30%, rgba(0,0,0,0.85) 100%);
}
.byb-vid-card .scrub {
  position: absolute; left: 20px; right: 20px; bottom: 88px;
  height: 2px; background: rgba(255, 255, 255, 0.18);
  z-index: 3;
}
.byb-vid-card .scrub-fill { height: 100%; width: 30%; }
.byb-vid-card .play {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 76px; height: 76px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12px 40px rgba(0,0,0,0.5);
  transition: transform 0.18s, background 0.18s;
}
.byb-vid-card:hover .play { transform: translate(-50%, -50%) scale(1.08); background: var(--pg-orange); }
.byb-vid-card .play::before {
  content: '';
  width: 0; height: 0;
  border-left: 22px solid #1a0e02;
  border-top: 14px solid transparent;
  border-bottom: 14px solid transparent;
  margin-left: 6px;
}
.byb-vid-card .badge {
  position: absolute; top: 16px; left: 16px;
  background: rgba(12, 10, 9, 0.7);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  padding: 6px 12px;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 10px;
  color: var(--pg-paper);
  z-index: 3;
  display: flex; align-items: center; gap: 6px;
}
.byb-vid-card .badge .swatch { width: 6px; height: 6px; display: inline-block; }
.byb-vid-card .runtime {
  position: absolute; top: 16px; right: 16px;
  background: rgba(12, 10, 9, 0.7);
  backdrop-filter: blur(8px);
  padding: 6px 10px;
  font-family: var(--font-display-alt);
  font-size: 11px;
  color: var(--pg-paper);
  z-index: 3;
  letter-spacing: 0.05em;
}
.byb-vid-card .meta {
  position: absolute; left: 20px; right: 20px; bottom: 20px;
  z-index: 3;
}
.byb-vid-card .meta .scent-label {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 11px;
  margin-bottom: 6px;
  display: inline-flex; align-items: center; gap: 6px;
}
.byb-vid-card .meta .scent-label .swatch { width: 8px; height: 8px; }
.byb-vid-card .meta .scent-name {
  font-family: var(--font-display);
  font-size: 36px;
  line-height: 0.92;
  text-transform: uppercase;
  color: var(--pg-paper);
  margin-bottom: 4px;
}
.byb-vid-card .meta .scent-tag {
  font-family: var(--font-body);
  font-size: 13px;
  color: rgba(255, 255, 255, 0.75);
  font-style: italic;
}

.byb-vid-arrows { display: flex; gap: 8px; }
.byb-vid-arrow {
  width: 48px; height: 48px;
  border: 1px solid var(--pg-line-2);
  background: var(--pg-card);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.18s;
}
.byb-vid-arrow:hover { background: var(--pg-orange); color: #1a0e02; border-color: var(--pg-orange); }
.byb-vid-arrow:disabled { opacity: 0.35; cursor: not-allowed; }

@media (max-width: 800px) {
  .byb-vid-card { flex: 0 0 280px; }
  .byb-vid-card .meta .scent-name { font-size: 30px; }
  .byb-vid-card .play { width: 60px; height: 60px; }
}

/* ── FRAGRANCE BLOCK ──────────────────────────── */
.byb-frag-section { background: var(--pg-bg); position: relative; }
.byb-scents-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}
@media (max-width: 900px) { .byb-scents-grid { grid-template-columns: 1fr; } }
.byb-scent-card {
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
  padding: 36px 32px 32px;
  position: relative;
  overflow: hidden;
  transition: background 0.4s ease, transform 0.3s ease, border-color 0.4s ease;
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 28px;
  align-items: start;
}
.byb-scent-card:hover { background: var(--pg-card-2); transform: translateY(-4px); }
.byb-scent-card::before {
  content: '';
  position: absolute;
  top: -60%; left: -20%;
  width: 140%; height: 140%;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.5s ease;
  pointer-events: none;
}
.byb-scent-card:hover::before { opacity: 1; }
.byb-scent-card[data-scent="underdog"]::before { background: rgba(196, 90, 44, 0.12); }
.byb-scent-card[data-scent="truenorth"]::before { background: rgba(58, 125, 92, 0.12); }
.byb-scent-card[data-scent="elprez"]::before { background: rgba(212, 160, 36, 0.12); }
.byb-scent-card[data-scent="sandal"]::before { background: rgba(139, 94, 60, 0.12); }
.byb-scent-card[data-scent="underdog"]:hover { border-color: rgba(196, 90, 44, 0.25); }
.byb-scent-card[data-scent="truenorth"]:hover { border-color: rgba(58, 125, 92, 0.25); }
.byb-scent-card[data-scent="elprez"]:hover { border-color: rgba(212, 160, 36, 0.25); }
.byb-scent-card[data-scent="sandal"]:hover { border-color: rgba(139, 94, 60, 0.25); }

.byb-scent-img {
  position: relative;
  aspect-ratio: 4/5;
  background: #0a0807;
  border: 1px solid var(--pg-line);
  overflow: hidden;
  z-index: 1;
}
.byb-scent-img img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.4s ease;
}
.byb-scent-card:hover .byb-scent-img img { transform: scale(1.04); }

.byb-scent-content { position: relative; z-index: 1; min-width: 0; }
.byb-scent-family {
  display: inline-block;
  font-family: var(--font-display-alt);
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  padding: 6px 12px;
  margin-bottom: 14px;
  font-weight: 600;
}
.byb-scent-card[data-scent="underdog"] .byb-scent-family {
  color: var(--underdog-2); background: rgba(196, 90, 44, 0.15);
  border: 1px solid rgba(196, 90, 44, 0.25);
}
.byb-scent-card[data-scent="truenorth"] .byb-scent-family {
  color: var(--truenorth-2); background: rgba(58, 125, 92, 0.15);
  border: 1px solid rgba(58, 125, 92, 0.25);
}
.byb-scent-card[data-scent="elprez"] .byb-scent-family {
  color: var(--elprez-2); background: rgba(212, 160, 36, 0.15);
  border: 1px solid rgba(212, 160, 36, 0.25);
}
.byb-scent-card[data-scent="sandal"] .byb-scent-family {
  color: var(--sandal-2); background: rgba(139, 94, 60, 0.15);
  border: 1px solid rgba(139, 94, 60, 0.25);
}
.byb-scent-content h3 {
  font-family: var(--font-display-alt);
  font-size: 36px;
  font-weight: 400;
  margin: 0 0 4px;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--pg-text);
}
.byb-scent-tagline {
  font-family: var(--font-body);
  font-style: italic;
  color: var(--pg-text-soft);
  font-size: 14px;
  margin: 0 0 16px;
}
.byb-scent-desc {
  color: var(--pg-text-soft);
  font-size: 14px;
  line-height: 1.65;
  margin-bottom: 24px;
}

.byb-notes-section { margin-bottom: 24px; }
.byb-notes-label {
  font-family: var(--font-display-alt);
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--pg-text-mute);
  margin-bottom: 12px;
  font-weight: 600;
}
.byb-note-row {
  display: grid;
  grid-template-columns: 90px 1fr;
  align-items: center;
  margin-bottom: 8px;
  gap: 12px;
}
.byb-note-name {
  font-size: 12px;
  color: var(--pg-text-soft);
  text-transform: capitalize;
}
.byb-note-bar-bg {
  height: 4px;
  background: rgba(255, 255, 255, 0.05);
  overflow: hidden;
}
.byb-note-bar-fill {
  height: 100%;
  width: 0;
  transition: width 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.byb-scent-card[data-scent="underdog"] .byb-note-bar-fill { background: linear-gradient(90deg, var(--underdog-1), var(--underdog-2)); }
.byb-scent-card[data-scent="truenorth"] .byb-note-bar-fill { background: linear-gradient(90deg, var(--truenorth-1), var(--truenorth-2)); }
.byb-scent-card[data-scent="elprez"] .byb-note-bar-fill { background: linear-gradient(90deg, var(--elprez-1), var(--elprez-2)); }
.byb-scent-card[data-scent="sandal"] .byb-note-bar-fill { background: linear-gradient(90deg, var(--sandal-1), var(--sandal-2)); }

.byb-smells-like {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-bottom: 24px;
}
.byb-smell-tag {
  font-size: 11.5px;
  padding: 6px 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--pg-text-soft);
  background: rgba(255, 255, 255, 0.02);
  font-family: var(--font-body);
}

.byb-meters {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding-top: 18px;
  border-top: 1px solid var(--pg-line);
}
.byb-meter { text-align: left; }
.byb-meter-label {
  font-family: var(--font-display-alt);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--pg-text-mute);
  margin-bottom: 8px;
  font-weight: 600;
}
.byb-meter-dots { display: flex; gap: 5px; }
.byb-meter-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}
.byb-scent-card[data-scent="underdog"] .byb-meter-dot.active { background: var(--underdog-1); }
.byb-scent-card[data-scent="truenorth"] .byb-meter-dot.active { background: var(--truenorth-1); }
.byb-scent-card[data-scent="elprez"] .byb-meter-dot.active { background: var(--elprez-1); }
.byb-scent-card[data-scent="sandal"] .byb-meter-dot.active { background: var(--sandal-1); }

.byb-scent-pick-btn {
  margin-top: 22px;
  width: 100%;
  padding: 14px 18px;
  background: transparent;
  border: 1.5px solid var(--pg-line-2);
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 12px;
  color: var(--pg-text);
  display: flex; align-items: center; justify-content: space-between;
  transition: all 0.2s;
}
.byb-scent-pick-btn:hover { border-color: var(--pg-orange); background: rgba(233, 133, 23, 0.06); color: var(--pg-orange); }
.byb-scent-pick-btn .arr { font-size: 16px; }

@media (max-width: 600px) {
  .byb-scent-card { grid-template-columns: 1fr; gap: 16px; padding: 24px 22px 22px; }
  .byb-scent-img { max-width: 200px; margin: 0 auto; }
}

/* ── HOW IT WORKS RIBBON ──────────────────────── */
.byb-how-strip {
  background: var(--pg-orange);
  color: #1a0e02;
  padding: 56px 32px;
  position: relative;
  overflow: hidden;
}
.byb-how-inner {
  max-width: 1340px; margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  align-items: start;
}
.byb-how-step .num {
  font-family: var(--font-display);
  font-size: 92px;
  line-height: 1;
  margin-bottom: 12px;
  color: #1a0e02;
  opacity: 0.95;
}
.byb-how-step .h {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  font-size: 24px;
  letter-spacing: 0.04em;
  margin: 0 0 8px;
}
.byb-how-step .b {
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.5;
  max-width: 320px;
  opacity: 0.85;
}
@media (max-width: 800px) {
  .byb-how-inner { grid-template-columns: 1fr; gap: 24px; }
  .byb-how-step .num { font-size: 64px; }
}

/* ── UGC GRID ─────────────────────────────────── */
.byb-ugc-strip { background: var(--pg-bg); }
.byb-ugc-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}
.byb-ugc-tile {
  position: relative;
  aspect-ratio: 1;
  background: var(--pg-card);
  overflow: hidden;
  cursor: pointer;
}
.byb-ugc-tile img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.byb-ugc-tile:hover img { transform: scale(1.06); }
.byb-ugc-tile .badge {
  position: absolute; top: 8px; left: 8px;
  background: rgba(12, 10, 9, 0.7);
  backdrop-filter: blur(6px);
  padding: 4px 8px;
  font-family: var(--font-display-alt);
  font-size: 10px;
  letter-spacing: 0.16em;
  color: #fff;
  z-index: 2;
}
.byb-ugc-tile .handle {
  position: absolute; bottom: 8px; left: 8px;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 600;
  color: #fff;
  z-index: 2;
  text-shadow: 0 1px 4px rgba(0,0,0,0.6);
}
.byb-ugc-tile::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 30%, transparent 70%, rgba(0,0,0,0.5) 100%);
}
.byb-ugc-tile.large { grid-column: span 2; grid-row: span 2; aspect-ratio: 1; }
@media (max-width: 900px) {
  .byb-ugc-grid { grid-template-columns: repeat(3, 1fr); }
  .byb-ugc-tile.large { grid-column: span 2; grid-row: span 2; }
}
@media (max-width: 540px) {
  .byb-ugc-grid { grid-template-columns: repeat(2, 1fr); }
  .byb-ugc-tile.large { grid-column: span 2; grid-row: span 2; }
}

/* ── REVIEWS ──────────────────────────────────── */
.byb-reviews-section {
  background: var(--pg-bg-2);
  border-top: 1px solid var(--pg-line);
}
.byb-review-summary {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 56px;
  align-items: center;
  margin-bottom: 56px;
  padding: 32px 32px;
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
}
.byb-review-score {
  text-align: center;
  border-right: 1px solid var(--pg-line);
  padding-right: 56px;
  min-width: 240px;
}
.byb-review-score .num {
  font-family: var(--font-display);
  font-size: 96px;
  line-height: 0.9;
  color: var(--pg-orange);
  margin-bottom: 4px;
}
.byb-review-score .stars {
  color: var(--pg-orange);
  font-size: 22px;
  letter-spacing: 4px;
  margin-bottom: 8px;
}
.byb-review-score .count {
  font-family: var(--font-display-alt);
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--pg-text-soft);
}
.byb-review-bars { flex: 1; }
.byb-review-bar-row {
  display: grid;
  grid-template-columns: 60px 1fr 50px;
  align-items: center;
  gap: 14px;
  margin-bottom: 8px;
  font-size: 13px;
  color: var(--pg-text-soft);
  font-family: var(--font-body);
}
.byb-review-bar-row .lbl {
  font-family: var(--font-display-alt);
  letter-spacing: 0.08em;
  font-size: 12px;
}
.byb-review-bar-bg {
  height: 6px;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}
.byb-review-bar-fill { height: 100%; background: var(--pg-orange); }
.byb-review-bar-row .pct { text-align: right; font-family: var(--font-display-alt); }

@media (max-width: 800px) {
  .byb-review-summary { grid-template-columns: 1fr; gap: 24px; padding: 24px; }
  .byb-review-score {
    border-right: 0;
    border-bottom: 1px solid var(--pg-line);
    padding-right: 0;
    padding-bottom: 24px;
  }
}

.byb-review-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.byb-review-card {
  background: var(--pg-card);
  border: 1px solid var(--pg-line);
  padding: 28px 26px;
  display: flex; flex-direction: column;
  position: relative;
}
.byb-review-card .stars { color: var(--pg-orange); letter-spacing: 3px; font-size: 14px; margin-bottom: 12px; }
.byb-review-card .verified {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--font-display-alt);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #4ade80;
  margin-bottom: 14px;
}
.byb-review-card .verified::before {
  content: '✓'; width: 14px; height: 14px;
  background: #4ade80; color: #0c1a0e;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px;
  font-weight: 700;
}
.byb-review-card .q {
  font-family: var(--font-display);
  font-size: 26px;
  line-height: 1.05;
  text-transform: uppercase;
  margin: 0 0 14px;
  color: var(--pg-text);
}
.byb-review-card .body {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.6;
  color: var(--pg-text-soft);
  margin: 0 0 18px;
  flex: 1;
}
.byb-review-card .who {
  display: flex; align-items: center; gap: 10px;
  padding-top: 14px;
  border-top: 1px solid var(--pg-line);
}
.byb-review-card .who .avatar {
  width: 36px; height: 36px;
  background: var(--pg-orange);
  color: #1a0e02;
  font-family: var(--font-display-alt);
  font-size: 14px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600;
}
.byb-review-card .who .meta { flex: 1; min-width: 0; }
.byb-review-card .who .name {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 13px;
  color: var(--pg-text);
  margin-bottom: 2px;
}
.byb-review-card .who .ctx {
  font-size: 11px;
  color: var(--pg-text-mute);
  font-family: var(--font-display-alt);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
@media (max-width: 800px) {
  .byb-review-grid { grid-template-columns: 1fr; }
}

/* ── INGREDIENTS ──────────────────────────────── */
.byb-ingr-section {
  background: var(--pg-bg);
  border-top: 1px solid var(--pg-line);
}
.byb-ingr-grid {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 56px;
  align-items: center;
}
.byb-ingr-img {
  position: relative;
  aspect-ratio: 4/5;
  background: var(--pg-card);
  overflow: hidden;
}
.byb-ingr-img img { width: 100%; height: 100%; object-fit: cover; }
.byb-ingr-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}
.byb-ingr-item {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 18px;
  padding: 16px 0;
  border-bottom: 1px solid var(--pg-line);
}
.byb-ingr-item:last-child { border-bottom: 0; }
.byb-ingr-item .ic {
  width: 56px; height: 56px;
  background: rgba(233, 133, 23, 0.1);
  border: 1px solid rgba(233, 133, 23, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-size: 28px;
  color: var(--pg-orange);
}
.byb-ingr-item .h {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  font-size: 18px;
  letter-spacing: 0.04em;
  margin: 0 0 4px;
  color: var(--pg-text);
}
.byb-ingr-item .b {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.55;
  color: var(--pg-text-soft);
}
@media (max-width: 800px) {
  .byb-ingr-grid { grid-template-columns: 1fr; gap: 32px; }
}

/* ── FAQ ──────────────────────────────────────── */
.byb-faq-section {
  background: var(--pg-bg-2);
  border-top: 1px solid var(--pg-line);
}
.byb-faq-list { max-width: 880px; margin: 0 auto; }
.byb-faq-item { border-bottom: 1px solid var(--pg-line); }
.byb-faq-q {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%;
  padding: 24px 0;
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  font-size: 18px;
  letter-spacing: 0.04em;
  text-align: left;
  color: var(--pg-text);
  transition: color 0.2s;
}
.byb-faq-q:hover { color: var(--pg-orange); }
.byb-faq-q .icon {
  width: 28px; height: 28px;
  border: 1.5px solid var(--pg-line-2);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-left: 24px;
  transition: all 0.2s;
}
.byb-faq-item.open .byb-faq-q .icon {
  background: var(--pg-orange); border-color: var(--pg-orange); color: #1a0e02;
}
.byb-faq-a {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.byb-faq-item.open .byb-faq-a { max-height: 400px; }
.byb-faq-a-inner {
  padding: 0 0 28px;
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.65;
  color: var(--pg-text-soft);
  max-width: 720px;
}

/* ── GUARANTEE BIG CTA ───────────────────────── */
.byb-guarantee {
  background:
    linear-gradient(180deg, rgba(12,10,9,0.85) 0%, rgba(12,10,9,0.55) 100%),
    url('{{ "byb-portrait-bearded-man.jpg" | asset_url }}') center/cover;
  padding: 96px 32px;
  text-align: center;
  border-top: 1px solid var(--pg-line);
}
.byb-guarantee-inner { max-width: 760px; margin: 0 auto; }
.byb-guarantee .seal {
  display: inline-flex; align-items: center; justify-content: center;
  width: 120px; height: 120px;
  border: 2px solid var(--pg-orange);
  border-radius: 50%;
  font-family: var(--font-display);
  text-transform: uppercase;
  font-size: 22px;
  line-height: 1;
  color: var(--pg-orange);
  text-align: center;
  margin: 0 auto 24px;
  padding: 14px;
  text-wrap: balance;
}
.byb-guarantee .byb-atc.inline {
  display: inline-flex; width: auto; padding: 20px 40px;
}

/* ── FOOTER ───────────────────────────────────── */
.byb-footer {
  background: #08070a;
  color: #fff;
  padding: 80px 32px 32px;
  border-top: 1px solid var(--pg-line);
}
.byb-footer-inner {
  max-width: 1340px; margin: 0 auto;
  display: grid;
  grid-template-columns: 1.4fr 2fr;
  gap: 80px;
}
.byb-footer-mark img { height: 56px; margin-bottom: 14px; }
.byb-footer-blurb {
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 1.6;
  color: var(--pg-text-soft);
  max-width: 360px;
}
.byb-footer-cols {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}
.byb-footer-cols h4 {
  font-family: var(--font-display-alt);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 12px;
  color: var(--pg-orange);
  margin: 0 0 14px;
}
.byb-footer-cols a {
  display: block;
  font-family: var(--font-body);
  font-size: 14px;
  line-height: 2;
  color: var(--pg-text-soft);
}
.byb-footer-cols a:hover { color: var(--pg-orange); }
.byb-footer-base {
  max-width: 1340px;
  margin: 56px auto 0;
  padding-top: 24px;
  border-top: 1px solid var(--pg-line);
  display: flex; align-items: center; justify-content: space-between;
  font-size: 12px;
  color: var(--pg-text-mute);
}
@media (max-width: 800px) {
  .byb-footer-inner { grid-template-columns: 1fr; gap: 40px; }
  .byb-footer-cols { grid-template-columns: repeat(2, 1fr); }
  .byb-footer-base { flex-direction: column; gap: 12px; text-align: center; }
}

/* ── STICKY ATC BAR ──────────────────────────── */
.byb-sticky-atc {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: rgba(12, 10, 9, 0.96);
  backdrop-filter: blur(14px);
  border-top: 1px solid var(--pg-line-2);
  padding: 14px 24px;
  z-index: 90;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.byb-sticky-atc.visible { transform: translateY(0); }
.byb-sticky-atc-inner {
  max-width: 1340px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 24px;
  align-items: center;
}
.byb-sticky-atc .left { display: flex; align-items: center; gap: 14px; }
.byb-sticky-atc .left .img {
  width: 48px; height: 60px;
  background: #0a0807;
  overflow: hidden; flex-shrink: 0;
}
.byb-sticky-atc .left .img img { width: 100%; height: 100%; object-fit: cover; }
.byb-sticky-atc .left .lbl {
  font-family: var(--font-display-alt);
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--pg-text);
  line-height: 1.1;
}
.byb-sticky-atc .left .sub {
  font-size: 12px;
  color: var(--pg-text-soft);
  font-family: var(--font-body);
  margin-top: 2px;
}
.byb-sticky-atc .center {
  display: flex; align-items: baseline; gap: 12px;
  justify-content: center;
}
.byb-sticky-atc .center .now {
  font-family: var(--font-display-alt);
  font-size: 26px;
  color: var(--pg-text);
}
.byb-sticky-atc .center .was {
  font-family: var(--font-display-alt);
  font-size: 16px;
  color: var(--pg-text-mute);
  text-decoration: line-through;
}
.byb-sticky-atc .center .save {
  font-family: var(--font-display);
  font-size: 22px;
  color: var(--pg-orange);
  transform: rotate(-3deg);
}
.byb-sticky-atc .right .byb-atc { padding: 16px 28px; font-size: 14px; }
@media (max-width: 800px) {
  .byb-sticky-atc-inner { grid-template-columns: 1fr auto; gap: 14px; }
  .byb-sticky-atc .left { display: none; }
  .byb-sticky-atc .center { justify-content: flex-start; }
  .byb-sticky-atc .right .byb-atc { padding: 14px 18px; font-size: 12px; }
}
